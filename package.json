{
  "name": "myblog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal knowledge system and publishing platform. Markdown is the source of truth.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/check/font-preload.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/db/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "content:sync": "tsx --conditions=react-server scripts/content/sync.ts",
    "content:validate": "tsx --conditions=react-server scripts/content/validate.ts",
    "content:reindex": "tsx --conditions=react-server scripts/content/reindex.ts",
    "content:import": "tsx --conditions=react-server scripts/content/import.ts",
    "content:links": "tsx --conditions=react-server scripts/content/links.ts",
    "content:stats": "tsx --conditions=react-server scripts/content/stats.ts",
    "brand:icons": "tsx scripts/brand/icons.ts",
    "check:font-preload": "tsx scripts/check/font-preload.ts",
    "serve:standalone": "tsx scripts/serve-standalone.ts",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@node-rs/argon2": "2.2.1",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@shikijs/transformers": "4.4.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "hast-util-to-string": "3.0.1",
    "katex": "0.18.7",
    "lucide-react": "1.45.0",
    "mdast-util-directive": "3.1.0",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.0.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-deflist": "1.0.0",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "shiki": "4.4.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/unist": "3.0.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "mdast-util-to-hast": "13.2.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
