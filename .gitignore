# Binaries and build outputs
/inkbranch
/bin/
/dist/
coverage.out

# Web frontend build & dependencies
web/node_modules/
web/dist/*
!web/dist/.gitkeep

# Local environment secrets
.env
.env.local
.env.*.local
.inkbranch-initial-admin-password

# Uploads are user data, not source
uploads/*
!uploads/.gitkeep

# Backups and runtime content locks/temp/recovery state
backups/
content/.locks/
content/.tmp/
content/.recovery/

# Logs and editor files
*.log
logs/
.cache/
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
