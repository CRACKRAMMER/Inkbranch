# Inkbranch v2 (Go Edition) Configuration Example

# Server
PORT=3000
HOST=0.0.0.0
SITE_URL=https://blog.crackrammer.com
SITE_NAME=Inkbranch
SITE_DESCRIPTION="Personal Knowledge System & Modern Publishing Platform"

# PostgreSQL 17 (optional in local read-only/preview mode; required in production)
DATABASE_URL=postgres://inkbranch:change-me@localhost:5432/inkbranch?sslmode=disable
DATABASE_POOL_MAX=10

# Security (generate 32+ random bytes in production, e.g. `openssl rand -base64 32`)
SESSION_SECRET=replace-with-32-byte-random-secret
TRUST_PROXY=true

# Paths
CONTENT_DIR=./content
UPLOADS_DIR=./uploads
BACKUPS_DIR=./backups

# Storage Driver: local | r2
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Bot Protection (Cloudflare Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Mail Delivery (SMTP and/or Resend HTTP API)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Inkbranch <noreply@blog.crackrammer.com>"
RESEND_API_KEY=

# Initial Admin Seed (only used when database has no users)
ADMIN_EMAIL=crackrammer@gmail.com
ADMIN_NAME=CRACKRAMMER
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_PASSWORD_FILE=./.inkbranch-initial-admin-password
