# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Required. The application stores indexes, sessions and analytics here.
# Article bodies are NOT stored in Postgres — they live in ./content.
DATABASE_URL=postgresql://myblog:change-me@localhost:5432/myblog
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Required in production. 32+ random bytes, base64 or hex.
#   openssl rand -base64 48
SESSION_SECRET=
# Cookie name. Change only if you run several instances on one host.
SESSION_COOKIE_NAME=myblog_session
# Session lifetimes (seconds).
SESSION_ABSOLUTE_TTL=2592000
SESSION_IDLE_TTL=604800
# Set to 1 when serving over HTTPS. Cookies get the Secure flag.
COOKIE_SECURE=0

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Used for canonical URLs, feeds, sitemap and OG images.
SITE_URL=http://localhost:3000
# Comma-separated hostnames permitted in analytics + iframe allow-lists.
TRUSTED_ORIGINS=localhost:3000

# ---------------------------------------------------------------------------
# Content
# ---------------------------------------------------------------------------
# Root of the Markdown source tree. Mounted as a volume in Docker.
CONTENT_DIR=./content
# Guard against a mis-mounted volume turning boot into a filesystem walk.
CONTENT_MAX_FILES=5000
# Skip the boot-time content sync entirely (useful for read-only deployments).
CONTENT_SYNC_ON_BOOT=1

# ---------------------------------------------------------------------------
# Admin account — read by `pnpm db:seed`, not by the application
# ---------------------------------------------------------------------------
# The owner created on the first seed. Re-running the seed never changes the
# password of an account that already exists, and never creates a second one.
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Your Name
# Required by `pnpm db:seed`. 12 characters or more. The seed refuses to run
# without it rather than generating one, because a generated password either
# ends up in a log or belongs to an account nobody can sign in to.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=./public/uploads
# Public URL prefix that maps to UPLOAD_DIR.
UPLOAD_URL_PREFIX=/uploads
# Bytes. Default 20 MiB.
MAX_UPLOAD_SIZE=20971520

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# Analytics can be disabled entirely; collection endpoints then 204.
ANALYTICS_ENABLED=1
# Days to keep raw analytics events before aggregation-only retention.
ANALYTICS_RAW_RETENTION_DAYS=30

# Git auto-commit of content. Off by default, never pushes.
GIT_INTEGRATION_ENABLED=0

# ---------------------------------------------------------------------------
# Background worker
# ---------------------------------------------------------------------------
# Starts the worker loop inside the server process. It is what publishes
# scheduled posts, rolls analytics up and prunes raw events. Set to 0 on an
# instance that should serve requests and nothing else; claims are leased, so
# any number of instances may have it on. `pnpm worker` runs the same loop in
# its own process and ignores this.
WORKER_ENABLED=1
# Interval between scheduled-job sweeps, milliseconds.
WORKER_INTERVAL_MS=60000
# Days of finished job history (done and failed) to keep.
JOB_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Testing
# ---------------------------------------------------------------------------
# A separate database for integration tests. Tests refuse to run without it.
TEST_DATABASE_URL=
